rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- who is asking ----
    function person() {
      return get(/databases/$(database)/documents/people/$(request.auth.uid)).data;
    }
    function known() {
      return request.auth != null
        && exists(/databases/$(database)/documents/people/$(request.auth.uid));
    }
    function isOwner() { return known() && person().role == 'owner'; }
    function isWorker() { return known() && person().role == 'worker'; }
    function myName() { return person().name; }

    // ---- row helpers (a missing `by` never matches a name) ----
    function oldBy() { return resource.data.get('by', null); }
    function newBy() { return request.resource.data.get('by', null); }
    function ownsOld() { return oldBy() == myName(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function voidOnly() { return changed().hasOnly(['void', 'voidBy']); }
    function backfillOnly() {
      return changed().hasOnly(['customerId'])
        && resource.data.get('customerId', null) == null;
    }
    function unconfirmed() { return resource.data.get('handedBy', null) in [null, '']; }

    // ---- payments ----
    function payCreateOk() {
      let d = request.resource.data;
      return newBy() == myName()
        && d.get('void', false) != true
        && d.get('handedBy', null) in [null, '']
        && d.get('alloc', null) in [null, []]
        && (d.get('handed', false) != true || d.get('holder', null) == 'Tài khoản Mẹ');
    }
    function claimOk() {
      let oldHolder = resource.data.get('holder', null);
      let newHolder = request.resource.data.get('holder', null);
      return changed().hasOnly(['holder'])
        && resource.data.get('handed', false) == false
        && ((oldHolder == 'Chưa ghi' && newHolder == myName())
            || (oldHolder == myName() && newHolder == 'Chưa ghi'));
    }

    // ---- collections where a worker owns what they wrote ----
    match /{coll}/{id} {
      allow read: if known() && coll in ['customers', 'orders', 'payments', 'production',
        'purchases', 'batches', 'losses', 'supplierPays', 'people'];
    }

    match /{coll}/{id} {
      allow write: if isOwner() && coll in ['customers', 'orders', 'payments', 'production',
        'purchases', 'batches', 'losses', 'supplierPays'];
    }

    match /orders/{id} {
      allow create: if isWorker() && newBy() == myName();
      allow update: if isWorker() && ((ownsOld() && voidOnly()) || backfillOnly());
      allow delete: if isWorker() && ownsOld();
    }

    match /{coll}/{id} {
      allow create: if isWorker() && coll in ['production', 'purchases', 'batches', 'losses']
        && newBy() == myName();
      allow update: if isWorker() && coll in ['production', 'purchases', 'batches', 'losses']
        && ownsOld() && voidOnly();
      allow delete: if isWorker() && coll in ['production', 'purchases', 'batches', 'losses']
        && ownsOld();
    }

    match /payments/{id} {
      allow create: if isWorker() && payCreateOk();
      allow update: if isWorker() && (claimOk() || backfillOnly());
      allow delete: if isWorker() && ownsOld() && unconfirmed();
    }

    match /customers/{id} {
      allow create, update: if isWorker();
    }

    // Everything else, including settings, stays denied (no rule matches it).
  }
}
